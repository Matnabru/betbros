
# Discord bot token
DISCORD_TOKEN=

# TheOddsAPI key
ODDS_API_KEY=

# API-Football / API-Sports key for exact-score odds
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
# Optional: set if you want to avoid a daily lookup of the Correct Score bet id
API_FOOTBALL_CORRECT_SCORE_BET_ID=
# Optional: set if you want to avoid a daily lookup of the Match Winner bet id
API_FOOTBALL_MATCH_WINNER_BET_ID=

# Notification Channel ID
NOTIFICATION_CHANNEL_ID=

# Admin User ID
ADMIN_USER_ID=

# MongoDB connection string
MONGO_URI=

SCRAPING_ANT_API_KEY=
# Set true/1/yes to route SofaScore fallback requests through ScrapingAnt.
USE_PROXY=false
SOFASCORE_PROXY_PROVIDER=scrape-do
SCRAPE_DO_TOKEN=
SCRAPE_DO_SUPER=true
SCRAPE_DO_GEO_CODE=pl
SCRAPE_DO_DEVICE=
SCRAPE_DO_RENDER=false
SCRAPE_DO_CUSTOM_HEADERS=false
ODDSCHECKER_SCRAPE_DO_SUPER=true
ODDSCHECKER_SCRAPE_DO_GEO_CODE=gb
ODDSCHECKER_SCRAPE_DO_DEVICE=
ODDSCHECKER_SCRAPE_DO_RENDER=false
SCRAPING_ANT_BROWSER=false
SCRAPING_ANT_PROXY_TYPE=
SCRAPING_ANT_PROXY_COUNTRY=
SOFASCORE_BOOKMAKER_ID=1137
